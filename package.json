{
  "name": "julius-pi-setup",
  "version": "0.1.0",
  "description": "Reusable Pi Coding Agent extensions and skills.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "pi-package",
    "pi-coding-agent",
    "coding-agent",
    "agent-skills"
  ],
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.84.4 <0.85.0",
    "@earendil-works/pi-coding-agent": ">=0.84.4 <0.85.0",
    "@earendil-works/pi-tui": ">=0.84.4 <0.85.0",
    "typebox": ">=1.3.7 <2"
  },
  "scripts": {
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "validate:runtime": "node scripts/validate-runtime.mjs",
    "sessions:report": "node scripts/retain-sessions.mjs",
    "migration:report": "node scripts/migrate-global-resources.mjs",
    "validate": "npm test && npm run typecheck && npm run validate:runtime && npm pack --dry-run",
    "prepublishOnly": "npm run validate"
  },
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/turndown": "^5.0.6",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "diff": "^5.2.0",
    "linkedom": "^0.16.11",
    "shell-quote": "^1.8.3",
    "turndown": "^7.2.0",
    "unpdf": "^1.4.0"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ]
  }
}
